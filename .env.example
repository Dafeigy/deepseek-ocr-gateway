# Required: create .env and fill this value.
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-OCR

# Upstream quotas. The adapter runs at 90% of these limits by default.
SILICONFLOW_RPM_LIMIT=1000
SILICONFLOW_TPM_LIMIT=80000
SILICONFLOW_RATE_UTILIZATION=0.90

# One upstream request per image/PDF page.
OCR_MAX_UPSTREAM_CONCURRENCY=8
OCR_MAX_PAGE_CONCURRENCY_PER_DOCUMENT=2
OCR_MAX_ACTIVE_DOCUMENTS=8
OCR_MAX_QUEUED_DOCUMENTS=32
OCR_DOCUMENT_QUEUE_TIMEOUT_SECONDS=30

# The reservation is adjusted using actual usage returned by SiliconFlow.
OCR_INITIAL_TOKENS_PER_PAGE=3000
OCR_MIN_TOKENS_PER_PAGE=512
OCR_MAX_TOKENS_PER_PAGE=8192
OCR_TOKEN_RESERVATION_FACTOR=1.25
OCR_RATE_WINDOW_SECONDS=60

OCR_MAX_OUTPUT_TOKENS=4096
OCR_MAX_RETRIES=2
OCR_UPSTREAM_TIMEOUT_SECONDS=180
OCR_PROMPT_MODE=grounding

OCR_MAX_DOCUMENT_BYTES=52428800
OCR_MAX_REQUEST_BODY_BYTES=73400320
OCR_MAX_PDF_PAGES=100
OCR_RENDER_DPI=144
OCR_RENDER_FORMAT=PNG
OCR_ALLOW_PRIVATE_URLS=false
OCR_DOWNLOAD_TIMEOUT_SECONDS=30
OCR_MAX_REDIRECTS=3

# Optional shared secret used by LiteLLM when calling this adapter.
# Leave empty only when the adapter is isolated on a trusted private network.
OCR_ADAPTER_API_KEY=
